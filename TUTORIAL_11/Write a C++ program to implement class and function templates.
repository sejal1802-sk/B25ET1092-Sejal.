#include <iostream>
#include <string>
using namespace std;

template <class T>
T maximumValue(T a, T b)
{
    return (a > b) ? a : b;
}

template <class T>
class Box
{
    T value;

public:
    Box(T v)
    {
        value = v;
    }

    void display()
    {
        cout << "Box value = " << value << endl;
    }
};

int main()
{
    cout << "Maximum integer = "
         << maximumValue(15, 40) << endl;

    cout << "Maximum double  = "
         << maximumValue(7.2, 9.8) << endl;

    Box<int> b1(250);
    b1.display();

    Box<string> b2("Generic Programming");
    b2.display();

    return 0;
}

OUTPUT:
Maximum integer = 40
Maximum double  = 9.8
Box value = 250
Box value = Generic Programming
