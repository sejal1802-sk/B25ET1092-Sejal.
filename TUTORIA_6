#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    friend istream& operator>>(istream& in, Complex& c);
    
    void display()
    {
        if (imag >= 0)
            cout << real << " + i" << imag << endl;
        else
            cout << real << " - i" << -imag << endl;
    }
};

istream& operator>>(istream& in, Complex& c)
{
    cout << "Enter real part: ";
    in >> c.real;

    cout << "Enter imaginary part: ";
    in >> c.imag;

    return in;
}

int main()
{
    Complex c;

    cout << "Enter complex number details:\n";
    cin >> c;

    cout << "Complex number is: ";
    c.display();

    return 0;
}
