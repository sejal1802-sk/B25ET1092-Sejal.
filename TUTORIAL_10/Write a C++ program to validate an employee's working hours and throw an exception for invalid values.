#include <iostream>
using namespace std;

int main()
{
    int hours;

    cout << "Enter employee working hours: ";
    cin >> hours;

    try
    {
        if (hours < 0 || hours > 24)
            throw hours;

        cout << "Valid working hours: " << hours << endl;
    }
    catch (int x)
    {
        cout << "Exception: Invalid working hours!" << endl;
    }

    return 0;
}

Output 1: Valid Input;
Enter employee working hours: 8
Valid working hours: 8

Output 2: Invalid Input
