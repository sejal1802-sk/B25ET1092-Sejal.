#include <iostream>
using namespace std;

class Complex
{
    int real, imag;

public:
    void input();
    void add(Complex, Complex);
    void display();
};

void Complex::input()
{
    cin >> real >> imag;
}

void Complex::add(Complex c1, Complex c2)
{
    real = real + c1.real + c2.real;
    imag = imag + c1.imag + c2.imag;
}

void Complex::display()
{
    if(imag >= 0)
        cout << real << " + " << imag << "i";
    else
        cout << real << " - " << -imag << "i";
}

int main()
{
    Complex c1, c2, c3, sum;

    cout << "Enter first complex number: ";
    c1.input();

    cout << "Enter second complex number: ";
    c2.input();

    cout << "Enter third complex number: ";
    c3.input();

    sum = c1;
    sum.add(c2, c3);

    cout << "Sum = ";
    sum.display();

    return 0;
}



